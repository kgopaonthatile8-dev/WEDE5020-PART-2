/* 2.2 Base + Reset + Colour Scheme */
* { margin: 0; padding: 0; box-sizing: border-box; }
:root { --primary: #2E7D32; --dark: #1B5E20; --accent: #8BC34A; --text: #333; --bg: #F1F8E9; --white: #fff; }
body { font-family: 'Segoe UI', Arial, sans-serif; font-size: 16px; line-height: 1.6; color: var(--text); background: var(--bg); }

/* 2.3 Typography */
h1 { font-size: 2.5rem; font-weight: 700; letter-spacing: -0.5px; }
h2 { font-size: 2rem; font-weight: 600; line-height: 1.2; color: var(--dark); }
h3 { font-size: 1.4rem; font-weight: 500; }
p { font-size: 1rem; margin-bottom: 1em; }

/* 2.4 Layout - Flexbox + Grid - Desktop Solution */
header { display: flex; justify-content: space-between; align-items: center; padding: 1rem 5%; background: var(--primary); }
nav ul { display: flex; gap: 2rem; list-style: none; }
nav a { color: var(--white); text-decoration: none; }
.main-container { display: grid; grid-template-columns: 2fr 1fr; grid-template-areas: "content sidebar"; gap: 2%; padding: 2rem 5%; }
.content { grid-area: content; }
.sidebar { grid-area: sidebar; background: var(--white); padding: 1.5rem; border-radius: 8px; }

/* 2.5 Visual + Interactive - :hover :focus :active */
.btn { display: inline-block; background: var(--primary); color: var(--white); padding: 0.75rem 1.5rem; border: 1px solid var(--primary); border-radius: 5px; box-shadow: 0 2px 5px rgba(0,0,0,0.2); transition: all 0.3s ease; text-decoration: none; }
.btn:hover { background: var(--dark); transform: translateY(-2px); box-shadow: 0 4px 10px rgba(0,0,0,0.3); }
.btn:active { transform: scale(0.98); }
a:focus, .btn:focus { outline: 3px solid var(--accent); }
img { max-width: 100%; height: auto; border-radius: 8px; }

/* 3.1 Breakpoints + 3.2 Relative Units rem/em/% */
@media screen and (max-width: 768px) {
  .main-container { grid-template-columns: 1fr; grid-template-areas: "content" "sidebar"; }
  header { flex-direction: column; }
  nav ul { flex-direction: column; gap: 0.5rem; text-align: center; }
  h1 { font-size: 1.8rem; }
  h2 { font-size: 1.6rem; }
}
@media screen and (max-width: 1024px) {
  .main-container { padding: 1rem 3%; }
}